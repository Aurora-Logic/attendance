{
  "name": "attendance-system",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @attendance/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @attendance/api dev",
    "build:agent": "pnpm --filter @attendance/tally-agent build"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
