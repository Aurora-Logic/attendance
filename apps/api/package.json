    "@vyuha/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.29",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.21.0",
    "@vyuha/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
