    "build": "tsup",
    "start:dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@attendance/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.0.8",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "prisma": "^7.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
