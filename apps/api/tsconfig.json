{
  "extends": "@vyuha/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    // The whole package, because `seed/` is typechecked too and sits beside
    // `src/`. Emit layout is not decided here -- `tsconfig.build.json` narrows
    // rootDir back to `src` so `nest build` still writes `dist/main.js`.
    "rootDir": ".",
    "baseUrl": ".",
    "types": ["node"],

    // NestJS dependency injection resolves constructor parameters from
    // design:paramtypes metadata, so both of these are load-bearing rather
    // than stylistic.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Nest's own decorator signatures do not satisfy exactOptionalPropertyTypes
    // in a few places; strictness is kept everywhere else.
    "exactOptionalPropertyTypes": false,

    "paths": {
      "@/*": ["src/*"]
    }
  },
  // drizzle.config.ts is deliberately outside the program: drizzle-kit
  // compiles it itself. `seed/` is inside it: the seed imports domain code
  // from `src/`, and a seed that only breaks when someone runs it is a seed
  // that breaks in front of an audience.
  "include": ["src/**/*.ts", "seed/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
