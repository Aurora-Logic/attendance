# Copy to .env.production (never committed) and fill every value. One file,
# two roles: docker-compose.prod.yml interpolates ${...} from it when given
# --env-file, and the api container loads it wholesale via env_file. The API
# validates all of it with Zod at boot and refuses to start on a missing or
# malformed value -- filling this in completely IS the deploy precondition.
#
# Owned by the compose file, do NOT set here: NODE_ENV, PORT, API_BASE_URL,
# WEB_BASE_URL, DATABASE_URL, REDIS_URL, TRUST_PROXY_HOPS. They are derived
# from the topology and from the values below.

# --- Site ----------------------------------------------------------------
# The public hostname, DNS already pointed at this box. TLS is automatic.
DOMAIN=
# Host ports Caddy binds. Leave unset for the production 80/443; a rehearsal
# stack sets these to keep off ports a dev stack holds.
#HTTP_PORT=
#HTTPS_PORT=

# --- Database ------------------------------------------------------------
# User and db name default to vyuha; the password has no default anywhere.
# Generate: openssl rand -base64 24
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Object storage (S3 API; R2 recommended, MinIO profile as fallback) ---
# R2:    S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#        S3_REGION=auto, credentials from an R2 API token scoped to the two
#        buckets, STORAGE_ORIGIN=https://<account-id>.r2.cloudflarestorage.com,
#        STORAGE_DOMAIN left empty.
# MinIO: start the stack with --profile minio; S3_ENDPOINT=https://<STORAGE_DOMAIN>,
#        S3_REGION=us-east-1, credentials invented here (they become MinIO's
#        root user), STORAGE_DOMAIN=storage.<your-domain> with DNS pointed at
#        this box, STORAGE_ORIGIN=https://<STORAGE_DOMAIN>.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PHOTOS=
S3_BUCKET_EXPORTS=
S3_FORCE_PATH_STYLE=true
# NFR-09: photo URLs are short-lived. 300 is the dev value; keep it small.
S3_SIGNED_URL_TTL_SECONDS=300
# The origin browsers fetch punch photos from, allowed by Caddy's CSP.
STORAGE_ORIGIN=
# MinIO only -- the hostname Caddy serves MinIO under. Empty for R2.
STORAGE_DOMAIN=

# --- Auth ----------------------------------------------------------------
# Two DIFFERENT values. Generate each: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Mail (real SMTP -- there is no Mailpit in this stack) ----------------
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=
# true for implicit TLS (usually port 465); false for STARTTLS (usually 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# e.g. Vyuha <no-reply@your-domain>
MAIL_FROM=

# --- Organisation defaults (REQ-L-01) ------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Background jobs -----------------------------------------------------
# One process must be true or nothing drains the queues; on one VPS that is
# this process.
JOBS_WORKER_ENABLED=true

# --- Observability -------------------------------------------------------
LOG_LEVEL=info
# Validated slot; the Sentry SDK itself is deferred (OPEN-QUESTIONS WS-A-1).
SENTRY_DSN=
