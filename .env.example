# ---- Core ----
NODE_ENV=development
COMPANY_TIMEZONE=Asia/Kolkata

# ---- Postgres (docker-compose) ----
DATABASE_URL=postgresql://attendance:attendance@localhost:5433/attendance?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, S3/R2 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_SELFIES=attendance-selfies
S3_FORCE_PATH_STYLE=true

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- Web ----
VITE_API_URL=http://localhost:3000

# ---- Mail (dev: Mailpit/Ethereal) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Delta Attendance <no-reply@example.com>"

# ---- Observability (optional in dev) ----
SENTRY_DSN=
LOG_LEVEL=debug
