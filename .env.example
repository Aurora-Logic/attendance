# Copy to .env for local development. Every variable here is validated by Zod
# at boot (technical design §17) — the API refuses to start if one is missing
# or malformed, rather than failing later at the first request that needs it.

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Reverse-proxy hops in front of the API. 0 for development (no proxy; the
# socket address is the client). Behind Caddy in production it must be exactly
# 1, or the per-IP login limit is either blind or spoofable (P0-11).
TRUST_PROXY_HOPS=0

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://vyuha:vyuha_dev_only@localhost:55432/vyuha

# --- Redis / BullMQ -----------------------------------------------------
REDIS_URL=redis://localhost:56379

# --- Object storage (S3-compatible; MinIO locally, R2 or S3 in production) --
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vyuha
S3_SECRET_ACCESS_KEY=vyuha_dev_only
S3_BUCKET_PHOTOS=vyuha-photos
S3_BUCKET_EXPORTS=vyuha-exports
S3_FORCE_PATH_STYLE=true
# NFR-09: photo URLs are short-lived and permission-checked, never public.
S3_SIGNED_URL_TTL_SECONDS=300

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_48_byte_random_value_before_running
JWT_REFRESH_SECRET=replace_me_with_a_different_48_byte_random_value
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# REQ-B-05 rotation tolerance, in seconds. 0 disables it.
#
# Within this window a repeat of the same refresh token returns the same
# replacement instead of being treated as theft. Without it, opening two tabs
# signs the person out of every session: both documents boot, both call
# /auth/refresh with the same cookie, and reuse detection revokes the family.
# Genuine replays arrive minutes later, so detection outside the window is
# unchanged. Ten seconds covers a browser restoring a window full of tabs.
AUTH_REFRESH_REPLAY_TOLERANCE_SECONDS=10

# --- Mail (off by default) ----------------------------------------------
# MAIL_TRANSPORT defaults to `log`: nothing below is required, the API boots
# with this whole block deleted, and no message is ever sent. The link is
# written to the application log in development, and withheld from it in
# production, where a token in a log aggregator is a token in everyone's hands.
#
# What that means for accounts, because it is the part that surprises people:
#
#   * Inviting somebody (REQ-B-03) still works. `POST /auth/invitations`
#     returns the accept link to the administrator who created it -- the
#     Employees screen shows it with a copy control -- and they pass it on by
#     whatever channel they already use. The link is single-use and expires in
#     72 hours whether it travelled by email or by WhatsApp.
#   * An administrator can issue a password reset the same way, from the same
#     menu (`POST /auth/password-resets/for-employee`).
#   * The self-service "forgot password" form still mints a token and still
#     answers 202, and with no transport that token reaches nobody. Somebody
#     locked out has to ask an administrator for a link.
#
# Set MAIL_TRANSPORT=smtp to send messages as well; SMTP_HOST and MAIL_FROM
# then become required and the API refuses to start without them. Nothing about
# the mailer, the transport interface or the notification events was removed,
# so this is a one-variable change (REQ-K-02).
MAIL_TRANSPORT=log
# Local Mailpit, for a developer who wants to read the messages. Ignored while
# MAIL_TRANSPORT is `log`.
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Vyuha <no-reply@vyuha.local>"

# --- Organisation defaults (REQ-L-01) -----------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Background jobs ----------------------------------------------------
# Splits the web and worker roles. One process must have it true or nothing
# drains the queues; on a single VPS that is the same process.
JOBS_WORKER_ENABLED=true

# --- Observability ------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
