# Copy to .env and fill in. Only the variables the code actually reads are
# listed; anything aspirational lives in DECISIONS.md, not here, so this file
# never drifts from reality.

# ---- Core ----
# `production` turns on: JWT secret enforcement (boot refuses a weak/absent
# secret), Secure cookies, and the CORS allowlist below.
NODE_ENV=development
PORT=3000
# Where the JSON store lives. Postgres is the system of record for attendance;
# this file carries what has no table yet. Back it up with the database.
DATA_FILE=./apps/api/.data/store.json

# ---- Auth (REQUIRED in production) ----
# Generate with: openssl rand -base64 48
# In production the API refuses to start if this is missing or under 32 chars.
JWT_ACCESS_SECRET=replace-me-with-a-real-48-byte-random-string

# ---- Behind a proxy ----
# Number of proxy hops to trust for the client IP (rate limits, login lockout
# and audit rows all key on it). Leave unset when the API is directly exposed.
# TRUST_PROXY=1

# ---- Logging ----
# fatal | error | warn | info | debug | trace. Defaults to info in production.
LOG_LEVEL=warn

# ---- CORS ----
# Comma-separated exact origins allowed to send credentialed requests.
# Defaults to the local Vite ports when unset.
CORS_ORIGINS=http://localhost:5177

# ---- Postgres (docker-compose maps 5433 to avoid a local 5432) ----
DATABASE_URL=postgresql://attendance:attendance@localhost:5433/attendance?schema=public

# ---- Redis / BullMQ (export worker) ----
REDIS_PORT=6379
# Set EXPORTS_QUEUE=0 to boot without Redis; export enqueue then reports
# UNAVAILABLE instead of failing requests.
# EXPORTS_QUEUE=0

# ---- Web (build-time; baked into the bundle) ----
# Must point at the deployed API — a production build with the default bakes
# localhost and the app cannot reach its own backend.
VITE_API_URL=http://localhost:3000
